BasedOnStyle: LLVM

# Line length similar to your code
ColumnLimit: 128

# KEEP function arguments on one line
BinPackArguments: true
BinPackParameters: true
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false

# Strongly discourage breaking calls
PenaltyBreakBeforeFirstCallParameter: 1000000
PenaltyBreakOpenParenthesis: 1000000
PenaltyBreakAssignment: 1000000
PenaltyBreakString: 1000000
PenaltyExcessCharacter: 1000000

# Brace style matches GTK
BreakBeforeBraces: Attach

# Pointer style: char *name
PointerAlignment: Right

# Indentation
IndentWidth: 4
TabWidth: 4
UseTab: Never

# Compact code blocks
AllowShortFunctionsOnASingleLine: Empty
AllowShortBlocksOnASingleLine: Empty
AllowShortEnumsOnASingleLine: false
AllowShortIfStatementsOnASingleLine: Never

# Alignment
AlignAfterOpenBracket: Align
AlignOperands: Align

# Includes
SortIncludes: false

# Spaces
SpaceBeforeParens: ControlStatements

# Prevent unwanted wrapping
AlwaysBreakTemplateDeclarations: No